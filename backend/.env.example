# Αντίγραψε σε .env για τοπική ανάπτυξη. Το .env ΔΕΝ μπαίνει στο repository.

# Τοπικά: SQLite. Στην παραγωγή το Render δίνει PostgreSQL URL.
DATABASE_URL=sqlite+pysqlite:///./mmm.db

# ⚠️ ΥΠΟΧΡΕΩΤΙΚΟ στην παραγωγή. Παρήγαγέ το με:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# Εμφάνιση SQL στην κονσόλα. Ποτέ true στην παραγωγή.
SQL_ECHO=false
